# Copy to .env (repository root). Both the API and the storefront read it.

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eynek

# API port (the storefront dev server proxies /api here)
PORT=5000

# Better Auth — generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the site (where /api/auth is reachable)
BETTER_AUTH_URL=http://localhost:5173
# Extra comma-separated origins allowed to call /api/auth (e.g. the www host)
AUTH_TRUSTED_ORIGINS=

# Optional Google sign-in (Google Cloud → OAuth client, redirect URI:
# <BETTER_AUTH_URL>/api/auth/callback/google). Set VITE_GOOGLE_SIGN_IN=true to show the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_SIGN_IN=false

# Transactional email (verification, password reset) via Resend.
# Without these, development prints the email to the API log instead.
RESEND_API_KEY=
EMAIL_FROM="EYNƏK.com <no-reply@xn--eynk-x6b.com>"

# Only this signed-in, verified email gets the admin panel
MARKETPLACE_ADMIN_EMAIL=hmdzadelnur@gmail.com

# S3-compatible storage for seller product images (Cloudflare R2 shown)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=eynek-product-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Comma-separated origins allowed to call the API cross-origin (normally empty)
CORS_ALLOWED_ORIGINS=
